<canvas id="starfield" aria-hidden="true"></canvas>

<script is:inline>
  (() => {
    const canvas = document.getElementById('starfield');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let stars = [];
    let meteor = null;
    let w = 0;
    let h = 0;
    let dpr = 1;

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      canvas.style.width = w + 'px';
      canvas.style.height = h + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.floor((w * h) / 3800);
      stars = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: Math.random() * 1.1 + 0.2,
        base: Math.random() * 0.55 + 0.25,
        phase: Math.random() * Math.PI * 2,
        speed: Math.random() * 0.5 + 0.2,
        drift: Math.random() * 0.045 + 0.01,
      }));
    }

    function spawnMeteor() {
      meteor = {
        x: Math.random() * w * 0.7 + w * 0.2,
        y: Math.random() * h * 0.25,
        vx: -(Math.random() * 6 + 7),
        vy: Math.random() * 3 + 3,
        life: 1,
      };
    }

    let t = 0;
    function frame() {
      t += 0.016;
      ctx.clearRect(0, 0, w, h);
      for (const s of stars) {
        const tw = s.base + Math.sin(t * s.speed + s.phase) * 0.25;
        ctx.globalAlpha = Math.max(0.05, tw);
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(s.x, s.y, s.r, s.r);
        s.y += s.drift;
        if (s.y > h) {
          s.y = -2;
          s.x = Math.random() * w;
        }
      }
      if (meteor) {
        ctx.globalAlpha = meteor.life * 0.85;
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.moveTo(meteor.x, meteor.y);
        ctx.lineTo(meteor.x - meteor.vx * 6, meteor.y - meteor.vy * 6);
        ctx.stroke();
        meteor.x += meteor.vx;
        meteor.y += meteor.vy;
        meteor.life -= 0.022;
        if (meteor.life <= 0) meteor = null;
      } else if (Math.random() < 0.0012) {
        spawnMeteor();
      }
      ctx.globalAlpha = 1;
      requestAnimationFrame(frame);
    }

    resize();
    window.addEventListener('resize', resize);

    if (reduced) {
      ctx.fillStyle = '#ffffff';
      for (const s of stars) {
        ctx.globalAlpha = s.base;
        ctx.fillRect(s.x, s.y, s.r, s.r);
      }
    } else {
      requestAnimationFrame(frame);
    }
  })();
</script>
