---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';

const posts = (await getCollection('log')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const recent = posts.slice(0, 6);
---

<Base>
  <section class="hero">
    <h1 class="hero-wordmark" aria-label="dobidugi">
      {'dobidugi'.split('').map((ch, i) => <span class="tw" style={`--i: ${i}`}>{ch}</span>)}
    </h1>
    <p class="hero-sub">engineering log</p>
    <a class="scroll-hint" href="#recent" aria-label="아래로 스크롤">▼</a>
  </section>

  <section class="section" id="recent">
    <div class="section-head">
      <h2 class="section-title">Recent Entries</h2>
      <a class="ghost-link" href="/log/">VIEW ALL {posts.length} →</a>
    </div>
    <div class="rows">
      {recent.map((post) => <PostRow post={post} />)}
    </div>
  </section>
</Base>
