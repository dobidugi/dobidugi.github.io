---
import { getCategoryLabel, getPostCategories } from '../lib/categories';

const { post } = Astro.props;
const categories = getPostCategories(post.data);
const d = post.data.date;
const pad = (n: number) => String(n).padStart(2, '0');
const dateStr = `${d.getFullYear()}.${pad(d.getMonth() + 1)}.${pad(d.getDate())}`;
---

<a class="post-row" href={`/log/${post.id}/`} data-cat={post.data.category} data-categories={JSON.stringify(categories)} data-year={d.getFullYear()}>
  <span class="pr-date">{dateStr}</span>
  <span class="pr-cat">{categories.map(getCategoryLabel).join(' · ')}</span>
  <span class="pr-main">
    <span class="pr-title">{post.data.title}</span>
    {post.data.description && <span class="pr-desc">{post.data.description}</span>}
  </span>
  <span class="pr-arrow">→</span>
</a>
